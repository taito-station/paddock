#!/usr/bin/env bash
# CI 相当の高速チェックを push 前に走らせ、落ちたら push を中断する（#178 で fmt 落ちを
# 手元で拾えなかった反省）。CI（.github/workflows/ci.yml）の fmt / clippy / web ステップを再現する。
# test は --test-threads=1 で時間がかかるため含めず、push 後の CI 確認で担保する。
# web/ の型エラー・lint 違反が CI まで到達するのを防ぐため、push 差分に web/ が含まれる場合に
# typecheck / lint を実行する（#463）。gen:api ドリフト検証は schema.d.ts を再生成して
# ワーキングツリーを汚すため pre-push には含めず、CI の web ジョブ（git diff --exit-code）で担保する。
# 緊急時の意図的バイパスは `git push --no-verify`（規約上は明示意図があるときのみ）。
#
# このフックはリポジトリ管理下（scripts/git-hooks/）に置き、scripts/install-git-hooks.sh で
# core.hooksPath を張って配線する（#414）。clone・並走 clone ごとに一度配線が要る。
# git はフックを作業ツリー最上位を CWD にして起動するため、下の scripts/*.sh は
# 相対解決できる。なお相対 core.hooksPath の性質上、scripts/git-hooks/ を含まないブランチ/worktree
# をチェックアウトした状態では git は「フック無し＝何もしない」で扱い、このチェックは走らない。
set -euo pipefail

echo "[pre-push] cargo fmt --all --check"
cargo fmt --all --check

# clippy は CI（.github/workflows/ci.yml）と厳密一致させる（--locked 込み。Cargo.lock ドリフトを手元で拾う）。
echo "[pre-push] cargo clippy --locked --workspace --all-targets -- -D warnings"
cargo clippy --locked --workspace --all-targets -- -D warnings

# Swagger UI の vendored feature が落ちるとビルド時の外部取得へ静かに戻る（ADR 0082）。
# 手元では curl があるので気づけない＝機械で固定する。検査自身の回帰テストを先に走らせる
# （`adr` ジョブと同じ順序。検査が壊れているのか本体が壊れたのかを切り分けられるようにする）。
echo "[pre-push] scripts/test-check-vendored-swagger.sh（検査自身の回帰）"
bash scripts/test-check-vendored-swagger.sh
echo "[pre-push] scripts/check-vendored-swagger.sh（Swagger UI の vendored 固定 ADR 0082）"
bash scripts/check-vendored-swagger.sh

# 変数直後の非 ASCII は UTF-8 ロケールの bash が変数名に取り込み、set -u で落ちる（#636）。
# launchd 経由は C ロケールなので壊れず、人が端末から叩いたときだけ落ちるため CI 任せにしない。
# なお shellcheck 側はこれを検出しない（`# shellcheck` で始まるコメントは
# ディレクティブ扱いになるので、この行の書き出しにも使えない）。
# ここでも「回帰テスト → 本番検査」の順に走らせる。
# この検査は python3 に依存するので、下の check-doc-classes.py と同じく
# **未セットアップで push を止めない**（CI の shellcheck ジョブが同じ検査で担保する）。
if command -v python3 >/dev/null 2>&1; then
    echo "[pre-push] scripts/test-check-shell-var-nonascii.sh（検査自身の回帰）"
    bash scripts/test-check-shell-var-nonascii.sh
    echo "[pre-push] scripts/check-shell-var-nonascii.sh（変数直後の非 ASCII #636）"
    bash scripts/check-shell-var-nonascii.sh
else
    echo "[pre-push] python3 が無いので変数直後の非 ASCII 検査はスキップ（CI の shellcheck ジョブで検出されます）"
fi

# 文書クラスと sources 追従の検査（ADR 0073）。差分ではなくリポジトリ全体の状態を見るので
# stdin は読まない（下の web 判定が stdin を消費するため、ここで読むと web 検査が壊れる）。
# python3 が無い環境では警告のみでスキップする。未セットアップで push を止めない既存方針に倣う
# （CI の adr ジョブでも同じ検査が走るので、その場合は PR 上で検出される）。
if command -v python3 >/dev/null 2>&1; then
    echo "[pre-push] scripts/check-doc-classes.py（文書クラス / sources 追従 ADR 0073）"
    python3 scripts/check-doc-classes.py
else
    echo "[pre-push] python3 が無いので check-doc-classes.py はスキップ（CI の adr ジョブで検出されます）"
fi

# web/ 差分がある push のときだけ typecheck / lint を走らせる（#463）。
# stdin から "local_ref local_sha remote_ref remote_sha" を読み取り、push 範囲の全コミットの
# 変更ファイルを確認する。remote_sha が 0000...（新規リモートブランチ）の場合は分岐元からの
# 全差分で判定する（先頭 1 コミットだけ見ると N コミット一括 push で中間の web 変更を取りこぼす）。
# local_sha が 0000...（delete push）は web 検査をスキップする。
web_changed=false
zero="0000000000000000000000000000000000000000"
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # delete push（ブランチ削除）は検査対象外
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    # 新規リモートブランチ: 分岐元（origin/main → main → root）からの全差分で web/ を判定する。
    # origin/main が無い環境（新規 clone 直後等）は main、それも無ければ root commit まで遡る。
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null \
           || git merge-base "$local_sha" main 2>/dev/null \
           || git rev-list --max-parents=0 "$local_sha" | tail -1)
    diff_files=$(git diff --name-only "$base".."$local_sha" 2>/dev/null || true)
  else
    diff_files=$(git diff --name-only "$remote_sha".."$local_sha" 2>/dev/null || true)
  fi
  if echo "$diff_files" | grep -q '^web/'; then
    web_changed=true
    break
  fi
done

if [ "$web_changed" = true ]; then
  # node_modules が未インストールなら警告してスキップ（npm install を強制しない）。
  # typecheck / lint は CI でも担保されるため、手元環境が未セットアップの場合は pass through する。
  if [ ! -d "web/node_modules" ]; then
    echo "[pre-push] web/node_modules が見つかりません（npm install 未実施？）。web の typecheck/lint をスキップします。"
    echo "[pre-push] CI の web ジョブが担保します。手元で確認するには: cd web && npm ci"
  else
    echo "[pre-push] web/ 差分あり: npm run typecheck"
    npm --prefix web run typecheck
    echo "[pre-push] web/ 差分あり: npm run lint"
    npm --prefix web run lint
  fi
else
  echo "[pre-push] web/ 差分なし: typecheck/lint スキップ"
fi

echo "[pre-push] OK（fmt / clippy / Swagger UI vendored / 変数直後の非 ASCII / 文書クラス / web 通過）"
